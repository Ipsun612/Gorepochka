# --- Required: secrets (never commit real values) ---
# Get Telegram token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Get key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# --- AI model: developer chooses the specific model here ---
# Examples:
#   openai/gpt-4o-mini
#   anthropic/claude-3.5-sonnet
#   google/gemini-flash-1.5
#   meta-llama/llama-3.1-8b-instruct:free
# Full list: https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# --- Optional: OpenRouter metadata / tuning ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional but recommended by OpenRouter for rate limits / analytics
APP_NAME=telegram-ai-bot
APP_URL=https://example.com
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_TIMEOUT_MS=60000

# --- System prompts: file-based (replaces SYSTEM_PROMPT env var) ---
# Any NN_name.txt/.md file in this dir is concatenated in prefix order.
# Example: prompts/01_base.txt, prompts/02_style.txt
PROMPTS_DIR=prompts
PROMPT_MAX_TOTAL_CHARS=32000

# --- Optional: access control ---
# Comma-separated Telegram user IDs allowed to use the bot. Empty = public.
# Get your ID from @userinfobot
# Example: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=

# --- Optional: safety limits ---
MAX_HISTORY_MESSAGES=20
MAX_MESSAGE_LENGTH=4000
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX_REQUESTS=3

# --- Persistent GorCOgramm profiles (single server; back up this database) ---
PROFILE_DB_PATH=data/profiles.sqlite
PROFILE_BIO_MAX_CHARS=2000

# --- AI reply delivery (Mini App) ---
# Only the exact Russian tag <Разделить сообщение> starts a separate message.
# First part appears immediately; subsequent parts wait for their own typing time.
AI_TYPING_CHARS_PER_SECOND=20
AI_TYPING_MIN_DELAY_MS=800
AI_TYPING_MAX_DELAY_MS=8000

# --- Image attachments (Mini App) ---
# Users can attach an image in ANY format; the server always re-encodes it to
# JPEG (EXIF orientation applied, metadata stripped) before the AI sees it.
# Max size of an uploaded source image (bytes). Larger uploads are rejected.
MAX_IMAGE_BYTES=10485760
# Longest side (px) the converted JPEG is scaled down to (keeps vision payloads small).
IMAGE_MAX_DIMENSION=1568
# JPEG quality (1-100) used when re-encoding uploads.
IMAGE_JPEG_QUALITY=80
# Reject images with more total pixels than this (decompression-bomb guard).
IMAGE_MAX_PIXELS=40000000

# --- Text-file attachments (Mini App) ---
# Users can attach any file that contains text (.txt, .md, .json, .cs, .js,
# config/log files, …); the server decodes it as UTF-8, rejects binary content
# and injects the text into the model prompt.
# Max size of an uploaded source text file (bytes). Larger uploads are rejected.
MAX_FILE_BYTES=2097152
# Max number of characters of file content injected into the prompt (rest truncated).
FILE_MAX_CHARS=20000

# --- Video attachments (Mini App) ---
# Users can attach a video; the server normalizes it to H.264/AAC MP4 and the
# model receives native video input. Circular video-notes share this pipeline
# with a 60-second cap (or VIDEO_MAX_DURATION_SECONDS when lower).
MAX_VIDEO_BYTES=104857600
VIDEO_MAX_DURATION_SECONDS=300
VIDEO_MAX_OUTPUT_BYTES=20971520
VIDEO_MAX_DIMENSION=1280
VIDEO_MAX_PIXELS=33177600
VIDEO_PROCESS_TIMEOUT_MS=180000
VIDEO_ANALYSIS_TIMEOUT_MS=180000
VIDEO_TTL_MS=3600000
VIDEO_MAX_CONCURRENT=2
VIDEO_MAX_STORED=20

# --- Voice messages (Mini App) ---
# Native audio goes to OPENROUTER_MODEL; it must support input_audio with MP3.
# No separate transcription service/model and no generated audio replies.
MAX_AUDIO_BYTES=20971520
AUDIO_MAX_DURATION_SECONDS=300
AUDIO_MAX_OUTPUT_BYTES=3145728
# Must be at least AUDIO_MAX_OUTPUT_BYTES. Recent recordings are reattached.
AUDIO_CONTEXT_MAX_BYTES=6291456
AUDIO_PROCESS_TIMEOUT_MS=60000
AUDIO_ANALYSIS_TIMEOUT_MS=180000
AUDIO_TTL_MS=3600000
AUDIO_MAX_CONCURRENT=2
AUDIO_MAX_STORED=50
# Optional decoder overrides; otherwise the project-local npm binaries are used.
FFMPEG_PATH=
FFPROBE_PATH=

# --- Mini App (Telegram WebApp) ---
# Public HTTPS URL of the Mini App frontend (this server's webapp/ dir).
# 1. Start the tunnel: npm run dev:tunnel  (cloudflared preferred; ngrok fallback)
# 2. Mini App at http://127.0.0.1:3000 — copy the public https URL here, restart.
# 3. /start the bot and tap "✨ Открыть мини-приложение".
# Must be HTTPS for Telegram. Empty = Mini App button shows setup instructions.
# NOTE: ngrok's FREE tier intercepts browser-looking requests (the Mini App page,
# scripts and API calls) behind a "You are about to visit…" interstitial, which
# leaves devices stuck on "connecting…" — use cloudflared or a paid ngrok plan.
WEBAPP_URL=
# Local static dir served at / (+ /api/* backend). Rarely needs changing.
WEBAPP_DIR=webapp
# Local port for the Mini App + API server.
PORT=3000
# Interface the API server binds to. Keep 127.0.0.1 — public traffic must go
# through the HTTPS tunnel only, never this port directly.
BIND_HOST=127.0.0.1
# SECURITY: unauthenticated anonymous /api access (plain-browser dev mode).
# off (default): every /api call requires a valid Telegram initData.
# on:            UNAUTHENTICATED requests are allowed using your OpenRouter key.
#                Dev tool ONLY — never enable together with a public WEBAPP_URL.
ANON_MODE=off
